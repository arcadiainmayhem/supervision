[Unit] 
Description = Prima Materia Supervision Installation
After = network.target

[Service]
WorkingDirectory=/home/arcadia/supervision
ExecStart=/home/arcadia/supervision/venv/bin/python3 main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target